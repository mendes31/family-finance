# Apache configuration for Family Finance Hub
# Este arquivo será copiado para dist/ após o build

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /family_finance/
  
  # Permitir acesso direto a favicon.ico (antes do redirecionamento SPA)
  RewriteCond %{REQUEST_URI} ^/family_finance/favicon\.ico$ [OR]
  RewriteCond %{REQUEST_URI} ^/favicon\.ico$
  RewriteRule ^ - [L]
  
  # Se o arquivo ou diretório existe, servir diretamente
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  
  # Redirecionar todas as requisições para index.html (SPA)
  RewriteRule ^ index.html [QSA,L]
</IfModule>

# Headers de segurança
<IfModule mod_headers.c>
  # Cache para assets estáticos (com versionamento no nome do arquivo)
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # Forçar revalidação de arquivos JS antigos sem hash no nome
  <FilesMatch "\.js$">
    Header append Cache-Control "must-revalidate"
  </FilesMatch>
  
  # Sem cache para index.html
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  
  # Forçar revalidação de arquivos JS (mesmo com hash no nome)
  <FilesMatch "index-.*\.js$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
    Header set ETag ""
  </FilesMatch>
</IfModule>

# Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

